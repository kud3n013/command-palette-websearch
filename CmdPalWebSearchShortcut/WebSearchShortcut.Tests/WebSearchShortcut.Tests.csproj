<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.26100.68-preview</WindowsSdkPackageVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    The extension is an MSIX-packaged WinExe whose module initializer bootstraps the Windows App SDK
    deployment manager. That throws REGDB_E_CLASSNOTREG outside the package, so referencing the project
    makes every test fail. Instead, compile the plain-logic sources directly into the test assembly.
  -->
  <PropertyGroup>
    <ExtensionSourceDir>..\WebSearchShortcut\</ExtensionSourceDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(ExtensionSourceDir)Browser\*.cs" LinkBase="Linked\Browser" />
    <Compile Include="$(ExtensionSourceDir)Helpers\*.cs" LinkBase="Linked\Helpers" />
    <Compile Include="$(ExtensionSourceDir)SuggestionsProviders\*.cs" LinkBase="Linked\SuggestionsProviders" />
    <Compile Include="$(ExtensionSourceDir)Services\UriHelper.cs" LinkBase="Linked\Services" />
    <Compile Include="$(ExtensionSourceDir)Services\SharedHttpClient.cs" LinkBase="Linked\Services" />
    <Compile Include="$(ExtensionSourceDir)Services\ShortcutImporter.cs" LinkBase="Linked\Services" />
    <Compile Include="$(ExtensionSourceDir)JSONContext.cs" LinkBase="Linked" />
    <Compile Include="$(ExtensionSourceDir)Storage.cs" LinkBase="Linked" />
    <Compile Include="$(ExtensionSourceDir)Suggestion.cs" LinkBase="Linked" />
    <Compile Include="$(ExtensionSourceDir)WebSearchShortcutDataEntry.cs" LinkBase="Linked" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CommandPalette.Extensions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

</Project>
